{
    "definition": {
        "": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
        "contentVersion": "1.0.0.0",
        "triggers": {
            "Recurrence": {
                "recurrence": {
                    "interval": 1,
                    "frequency": "Day",
                    "timeZone": "India Standard Time",
                    "schedule": {
                        "hours": [
                            9
                        ],
                        "minutes": [
                            0
                        ]
                    }
                },
                "type": "Recurrence"
            }
        },
        "actions": {
            "Execute_a_SQL_query_(V2)": {
                "runAfter": {},
                "type": "ApiConnection",
                "inputs": {
                    "host": {
                        "connection": {
                            "name": "@parameters('')['sqldw']['connectionId']"
                        }
                    },
                    "method": "post",
                    "body": {
                        "query": "SELECT TOP 3 StudentID, Name, Email, TotalFee, PaidAmount, DueDate FROM dbo.Students WHERE PaidAmount < TotalFee AND DueDate < GETDATE();"
                    },
                    "path": "/v2/datasets/@{encodeURIComponent(encodeURIComponent('default'))},@{encodeURIComponent(encodeURIComponent('default'))}/query/sql",
                    "retryPolicy": {
                        "type": "exponential",
                        "count": 3,
                        "interval": "PT5S",
                        "minimumInterval": "PT5S",
                        "maximumInterval": "PT30S"
                    }
                }
            },
            "For_each": {
                "foreach": "@body('Execute_a_SQL_query_(V2)')?['ResultSets']?['Table1']",
                "actions": {
                    "Send_an_email_(V2)": {
                        "runAfter": {},
                        "type": "ApiConnection",
                        "inputs": {
                            "host": {
                                "connection": {
                                    "name": "@parameters('')['outlook']['connectionId']"
                                }
                            },
                            "method": "post",
                            "body": {
                                "To": "@items('For_each')?['Email']",
                                "Subject": "Fee Payment Reminder",
                                "Body": "<p>Dear @{items('For_each')?['Name']},<br><br>This is a reminder that your tuition fee payment is overdue.<br><br>Student ID: @{items('For_each')?['StudentID']}<br>Total Fee: @{items('For_each')?['TotalFee']}<br>Paid Amount: @{items('For_each')?['PaidAmount']}<br>Outstanding Amount: @{sub(items('For_each')?['TotalFee'], items('For_each')?['PaidAmount'])}<br>Due Date: @{items('For_each')?['DueDate']}<br><br>Please complete the remaining payment as soon as possible.<br><br>Regards,<br>Finance Office</p>",
                                "Importance": "Normal"
                            },
                            "path": "/v2/Mail",
                            "retryPolicy": {
                                "type": "none"
                            }
                        }
                    },
                    "Delay_Between_Emails": {
                        "runAfter": {
                            "Send_an_email_(V2)": [
                                "Succeeded",
                                "Failed",
                                "Skipped",
                                "TimedOut"
                            ]
                        },
                        "type": "Wait",
                        "inputs": {
                            "interval": {
                                "count": 10,
                                "unit": "Second"
                            }
                        }
                    }
                },
                "runAfter": {
                    "Execute_a_SQL_query_(V2)": [
                        "Succeeded"
                    ]
                },
                "runtimeConfiguration": {
                    "concurrency": {
                        "repetitions": 1
                    }
                },
                "type": "Foreach"
            }
        },
        "outputs": {},
        "parameters": {
            "": {
                "type": "Object",
                "defaultValue": {}
            }
        }
    },
    "parameters": {
        "": {
            "value": {
                "sqldw": {
                    "id": "/subscriptions/948f0f29-ef48-4b74-925d-69114cba60fc/providers/Microsoft.Web/locations/centralindia/managedApis/sqldw",
                    "connectionId": "/subscriptions/948f0f29-ef48-4b74-925d-69114cba60fc/resourceGroups/fee-management/providers/Microsoft.Web/connections/sqldw",
                    "connectionName": "sqldw",
                    "connectionProperties": {}
                },
                "outlook": {
                    "id": "/subscriptions/948f0f29-ef48-4b74-925d-69114cba60fc/providers/Microsoft.Web/locations/centralindia/managedApis/outlook",
                    "connectionId": "/subscriptions/948f0f29-ef48-4b74-925d-69114cba60fc/resourceGroups/fee-management/providers/Microsoft.Web/connections/outlook",
                    "connectionName": "outlook",
                    "connectionProperties": {}
                }
            }
        }
    }
}